{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
    "cooldown_seconds": 15,
    "timeout_seconds": 10,
    "notify_on_fallback": true,
    "restore_primary_after_cooldown": true
  },
  "agents": {
    "sisyphus": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "high",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode-go/glm-5.2" }
      ],
      "prompt_append": "Intent gate: On each new user request, classify intent before acting. Analysis-oriented requests (analyze, research, compare, evaluate, audit, investigate, gather context, look into) default to exploration-first: gather context, do not modify files unless explicitly asked, then present findings and ask before implementing. Execution-oriented requests (implement, add, create, fix, change, write, build, deploy) proceed with normal planning and execution. If ambiguous, ask the user whether they want analysis first or implementation.",
      "ultrawork": {
        "model": "zai-coding-plan/glm-5.1",
        "variant": "high",
        "fallback_models": [
          { "model": "opencode-go/glm-5.1" },
          { "model": "opencode/kimi-k2.5" }
        ]
      }
    },
    "hephaestus": {
      "model": "zai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "Explore thoroughly, then implement. Prefer small, testable changes."
    },
    "oracle": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "high",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode-go/qwen3.7-max" },
        { "model": "opencode/gpt-5.4" }
      ],
      "prompt_append": "Think step-by-step. Identify root causes, not symptoms. Propose alternatives before recommending. Prioritize correctness and maintainability."
    },
    "librarian": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "Focus on production-ready patterns and official documentation. Skip basic tutorials. Include version numbers, source URLs, and concrete code examples."
    },
    "explore": {
      "model": "opencode-go/minimax-m2.7",
      "fallback_models": [
        { "model": "zai-coding-plan/glm-4.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "Search thoroughly but efficiently. Return file paths with pattern descriptions. Skip test files unless specifically asked. Prioritize implementation files over config."
    },
    "multimodal-looker": {
      "model": "zai-coding-plan/glm-4.6v",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2-omni" },
        { "model": "opencode/mimo-v2.5-free" }
      ]
    },
    "prometheus": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        { "model": "zai-coding-plan/glm-5.2" },
        { "model": "opencode/glm-5.1" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/prometheus-guidance.md"
    },
    "metis": {
      "model": "zai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode-go/qwen3.6-plus" }
      ]
    },
    "momus": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode/gpt-5.4" }
      ]
    },
    "atlas": {
      "model": "zai-coding-plan/glm-5-turbo",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.6" },
        { "model": "opencode/kimi-k2.6" }
      ]
    },
    "sisyphus-junior": {
      "model": "zai-coding-plan/glm-5-turbo",
      "fallback_models": [
        { "model": "opencode-go/qwen3.7-plus" },
        { "model": "opencode/kimi-k2.6" }
      ]
    },
    "archivist": {
      "model": "zai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "athena": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "auditor": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "explorer": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "post-reviewer": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "reviewer": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "zai-coding-plan/glm-5v-turbo",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2.5" },
        { "model": "opencode-go/mimo-v2-omni" },
        { "model": "opencode/gemini-3.1-pro" }
      ]
    },
    "ultrabrain": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        { "model": "zai-coding-plan/glm-5.2" },
        { "model": "opencode/glm-5.2" }
      ]
    },
    "deep": {
      "model": "zai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "artistry": {
      "model": "opencode-go/mimo-v2-omni",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2.5" },
        { "model": "opencode/mimo-v2.5-free" },
        { "model": "opencode/gemini-3-flash" }
      ]
    },
    "quick": {
      "model": "zai-coding-plan/glm-4.5-air",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "unspecified-low": {
      "model": "zai-coding-plan/glm-4.6",
      "fallback_models": [
        { "model": "opencode-go/qwen3.5-plus" },
        { "model": "opencode/mimo-v2.5-free" }
      ]
    },
    "unspecified-high": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/kimi-k2.5" }
      ]
    },
    "writing": {
      "model": "zai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "git-commit-message": {
      "model": "opencode/deepseek-v4-flash-free",
      "fallback_models": [{ "model": "zai-coding-plan/glm-4.5-air" }],
      "description": "All git operations — commits, branches, rebases, history searches",
      "prompt_append": "Focus on atomic commits, clear conventional commit messages, and safe operations. Never force-push or skip hooks unless explicitly requested."
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 180000,
    "providerConcurrency": {
      "opencode-go": 10,
      "opencode": 10,
      "zai-coding-plan": 5
    },
    "modelConcurrency": {
      "zai-coding-plan/glm-5.2": 1,
      "zai-coding-plan/glm-5.1": 2,
      "zai-coding-plan/glm-5v-turbo": 2,
      "zai-coding-plan/glm-5-turbo": 3,
      "zai-coding-plan/glm-4.7": 5,
      "zai-coding-plan/glm-4.6v": 2,
      "zai-coding-plan/glm-4.6": 5,
      "zai-coding-plan/glm-4.5-air": 10,
      "opencode-go/kimi-k2.7-code": 1,
      "opencode-go/kimi-k2.6": 2,
      "opencode-go/kimi-k2.5": 3
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true,
    "preemptive_compaction": true
  },
  "git_master": {
    "include_co_authored_by": false
  }
}
