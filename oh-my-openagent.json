{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "auto_update": false,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
    "cooldown_seconds": 15,
    "timeout_seconds": 10,
    "notify_on_fallback": true,
    "restore_primary_after_cooldown": true
  },
  "agents": {
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "variant": "high",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode-go/glm-5.2" },
        { "model": "opencode/glm-5.1" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/sisyphus-guidance.md",
      "ultrawork": {
        "model": "zhipuai-coding-plan/glm-5.1",
        "variant": "high",
        "fallback_models": [
          { "model": "opencode-go/glm-5.1" },
          { "model": "opencode/kimi-k2.5" }
        ]
      }
    },
    "hephaestus": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/hephaestus-guidance.md"
    },
    "oracle": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "variant": "high",
      "fallback_models": [{ "model": "opencode/gpt-5.4" }],
      "prompt_append": "file://~/.config/opencode/prompts/oracle-guidance.md"
    },
    "librarian": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/librarian-guidance.md"
    },
    "explore": {
      "model": "opencode-go/minimax-m2.7",
      "fallback_models": [
        { "model": "zhipuai-coding-plan/glm-4.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/explore-guidance.md"
    },
    "multimodal-looker": {
      "model": "zhipuai-coding-plan/glm-4.6v",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2-omni" },
        { "model": "opencode/mimo-v2.5-free" }
      ]
    },
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/glm-5.1" }
      ],
      "prompt_append": "file://~/.config/opencode/prompts/prometheus-guidance.md"
    },
    "metis": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode-go/qwen3.6-plus" }
      ]
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode/gpt-5.4" }
      ]
    },
    "atlas": {
      "model": "zhipuai-coding-plan/glm-5-turbo",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.6" },
        { "model": "opencode/kimi-k2.6" }
      ]
    },
    "sisyphus-junior": {
      "model": "zhipuai-coding-plan/glm-5-turbo",
      "fallback_models": [
        { "model": "opencode-go/qwen3.7-plus" },
        { "model": "opencode/kimi-k2.6" }
      ]
    },
    "archivist": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "athena": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "auditor": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "explorer": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "post-reviewer": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/glm-5.2" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "reviewer": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/glm-5.2" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "fullstack-dev-tester": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "zhipuai-coding-plan/glm-5v-turbo",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2.5" },
        { "model": "opencode-go/mimo-v2-omni" },
        { "model": "opencode/gemini-3.1-pro" }
      ]
    },
    "ultrabrain": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.7-code" },
        { "model": "opencode/glm-5.2" }
      ]
    },
    "deep": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "artistry": {
      "model": "opencode-go/mimo-v2-omni",
      "fallback_models": [
        { "model": "opencode-go/mimo-v2.5" },
        { "model": "opencode/gemini-3-flash" }
      ]
    },
    "quick": {
      "model": "zhipuai-coding-plan/glm-4.5-air",
      "fallback_models": [
        { "model": "opencode-go/minimax-m2.7" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.6",
      "fallback_models": [
        { "model": "opencode-go/qwen3.5-plus" },
        { "model": "opencode/mimo-v2.5-free" }
      ]
    },
    "unspecified-high": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" },
        { "model": "opencode/kimi-k2.5" }
      ]
    },
    "writing": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback_models": [
        { "model": "opencode-go/glm-5.1" },
        { "model": "opencode/kimi-k2.5" },
        { "model": "opencode/deepseek-v4-flash-free" }
      ]
    },
    "git-commit-message": {
      "model": "opencode/deepseek-v4-flash-free",
      "fallback_models": [{ "model": "zhipuai-coding-plan/glm-4.5-air" }],
      "description": "All git operations — commits, branches, rebases, history searches",
      "prompt_append": "file://~/.config/opencode/prompts/git-commit-message-guidance.md"
    }
  },
  "background_task": {
    "defaultConcurrency": 10,
    "staleTimeoutMs": 180000,
    "providerConcurrency": {
      "opencode-go": 10,
      "opencode": 10,
      "zhipuai-coding-plan": 10
    },
    "modelConcurrency": {
      "zhipuai-coding-plan/glm-5.2": 2,
      "zhipuai-coding-plan/glm-5.1": 3,
      "zhipuai-coding-plan/glm-5v-turbo": 1,
      "zhipuai-coding-plan/glm-5-turbo": 3,
      "zhipuai-coding-plan/glm-4.7": 5,
      "zhipuai-coding-plan/glm-4.6v": 2,
      "zhipuai-coding-plan/glm-4.6": 5,
      "zhipuai-coding-plan/glm-4.5-air": 10,
      "opencode-go/kimi-k2.7-code": 1,
      "opencode-go/kimi-k2.6": 2,
      "opencode-go/kimi-k2.5": 3
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true,
    "preemptive_compaction": true
  },
  "git_master": {
    "include_co_authored_by": false
  }
}
