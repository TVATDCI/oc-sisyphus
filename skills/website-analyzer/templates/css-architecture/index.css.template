/* ============================================================
   Keyframe Definitions
   Add more from DESIGN.md Section 15
   ============================================================ */

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

@keyframes pulse-glow {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slide-up {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slide-in-right {
  from { opacity: 0; transform: translateX(100px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes slide-out-right {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(100px); }
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes fade-scale-out {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.9); }
}

@keyframes wave {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes fade-slide-up {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fade-zoom {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes char-reveal {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Additional keyframes from runtime analysis - Add more as needed */
@keyframes fadeAndZoom {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes fadeScaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes slowFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes pulseOpacity {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

@keyframes waveMotion {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(10px); }
}

@keyframes elegant-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-15px) rotate(2deg); }
}

@keyframes solar-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

/* ============================================================
   Utility Classes
   ============================================================ */

/* Animation Utilities */
.animate-float { animation: var(--animate-float); }
.animate-spin-slow { animation: var(--animate-spin-slow); }
.animate-pulse-glow { animation: var(--animate-pulse-glow); }
.animate-fade-in { animation: var(--animate-fade-in); }
.animate-slide-up { animation: var(--animate-slide-up); }
.animate-slide-in-right { animation: var(--animate-slide-in-right); }
.animate-scale-in { animation: var(--animate-scale-in); }
.animate-fade-scale-out { animation: var(--animate-fade-scale-out); }
.animate-wave { animation: var(--animate-wave); }
.animate-fade-slide-up { animation: var(--animate-fade-slide-up); }
.animate-fade-zoom { animation: var(--animate-fade-zoom); }
.animate-char-reveal { animation: var(--animate-char-reveal); }

/* From runtime analysis */
.animate-fadeAndZoom { animation: fadeAndZoom 0.5s ease-out forwards; }
.animate-fadeScaleIn { animation: fadeScaleIn 0.4s ease-out forwards; }
.animate-slowFloat { animation: slowFloat 8s ease-in-out infinite; }
.animate-slideIn { animation: slideIn 0.5s ease-out forwards; }
.animate-pulseOpacity { animation: pulseOpacity 2s ease-in-out infinite; }
.animate-waveMotion { animation: waveMotion 3s ease-in-out infinite; }
.animate-elegant-float { animation: elegant-float 6s ease-in-out infinite; }
.animate-solar-spin { animation: solar-spin 20s linear infinite; }
.animate-rotate { animation: rotate 10s linear infinite; }
.animate-spin { animation: spin 1s linear infinite; }
.animate-pulse { animation: pulse 2s ease-in-out infinite; }

/* Transition Utilities */
.transition-button {
  transition: all 2s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.transition-anchor {
  transition: all 0.7s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.transition-glass {
  transition: all 3s cubic-bezier(0.075, 0.82, 0.165, 1);
}

/* Glass Morphism System */
.glass {
  background: oklch(100% 0 0 / 0.07);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid oklch(100% 0 0 / 0.1);
}

.glass-light {
  background: oklch(100% 0 0 / 0.03);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid oklch(100% 0 0 / 0.05);
}

.glass-heavy {
  background: oklch(100% 0 0 / 0.15);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid oklch(100% 0 0 / 0.2);
}

/* Gradient Text */
.gradient-text-accent {
  background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-5));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-prime {
  background: linear-gradient(135deg, var(--color-prime-planet), var(--color-gold-planet));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-brand {
  background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-3));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Planet Gradient System */
.planet-gold {
  background: linear-gradient(135deg, var(--color-gold-planet), var(--color-orange-planet));
}

.planet-green {
  background: linear-gradient(135deg, var(--color-green-planet), oklch(70% 0.15 142));
}

.planet-orange {
  background: linear-gradient(135deg, var(--color-orange-planet), oklch(60% 0.2 25));
}

.planet-purple {
  background: linear-gradient(135deg, var(--color-purple-planet), oklch(60% 0.25 285));
}

.planet-white {
  background: linear-gradient(135deg, var(--color-white-planet), oklch(90% 0.01 285));
}

.planet-prime {
  background: linear-gradient(135deg, var(--color-prime-planet), var(--color-gold-planet));
}

/* Stagger System */
.stagger-item {
  opacity: 0;
  animation: fade-slide-up 0.6s ease-out forwards;
  animation-delay: calc(var(--stagger-index, 0) * 100ms);
}

/* Focus Visible */
:focus-visible {
  outline: 2px solid var(--color-accent-5);
  outline-offset: 2px;
}

/* Utility Classes with @supports */
.work {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-rhythm-sm);
}

.accent-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.5;
}

.clip-card {
  clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%);
}

.tech-orbit {
  animation: solar-spin 30s linear infinite;
}

.conic-accent {
  background: conic-gradient(from 0deg, var(--color-accent-1), var(--color-accent-5), var(--color-accent-1));
}

.bg-mix-accent {
  background-color: color-mix(in oklch, var(--color-background) 90%, var(--color-accent-5) 10%);
}

@supports not (background-color: color-mix(in oklch, red, blue)) {
  .bg-mix-accent {
    background-color: var(--color-background);
  }
}

/* ============================================================
   Accessibility
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Screen reader only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* ============================================================
   Base Styles
   ============================================================ */

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background-color: var(--color-background);
  color: var(--color-text-base);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Selection */
::selection {
  background: oklch(82.46% 0.1405 190.2 / 0.3);
  color: var(--color-text-base);
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-background-alt);
}

::-webkit-scrollbar-thumb {
  background: var(--color-n-4);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-n-3);
}
