{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask"
    }
  },
  "plugin": [
    [
      "./plugins/sisyphus-gates",
      {
        "verdict_key_command": "cat ~/.local/share/sisyphus-gate-key",
        "sandbox_paths": [
          "/tmp/"
        ],
        "sandbox_allowed_commands": [
          "npm install",
          "npm test",
          "npm run ",
          "bun add ",
          "bun install",
          "bunx ",
          "node ",
          "tsc --noEmit",
          "git diff",
          "git show",
          "git log"
        ]
      }
    ]
  ],
  "default_agent": "sisyphus",
  "agent": {
    "brief-loader": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "prd-writer": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "momus-prd-reviewer": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "issue-creator": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "plan-writer": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "momus-plan-reviewer": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "wave-executor": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "plan-updater": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "plan-closer": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "code-review": {
      "model": "opencode-go/qwen3.8-max",
      "variant": "xhigh"
    },
    "security-auditor": {
      "model": "opencode-go/qwen3.8-max",
      "variant": "xhigh"
    },
    "ui-auditor": {
      "model": "opencode-go/qwen3.8-max",
      "variant": "xhigh"
    },
    "regression-gate": {
      "model": "opencode-go/gpt-5.6-luna",
      "variant": "low"
    },
    "reference-checker": {
      "model": "opencode-go/gpt-5.6-luna",
      "variant": "low"
    },
    "tdd-executor": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "archivist": {
      "model": "zai-coding-plan/glm-5.3-flash"
    },
    "athena": {
      "model": "zai-coding-plan/glm-5.3-flash"
    },
    "auditor": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "explorer": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "max"
    },
    "fullstack-dev-tester": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "oracle": {
      "model": "opencode-go/kimi-k3.1-pro",
      "variant": "max"
    },
    "post-reviewer": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "reviewer": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "sisyphus": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "max"
    }
  },
  "model_fallback": {
    "zai-coding-plan/glm-5.3-flash": [
      "opencode-go/glm-5.3-flash",
      "opencode-go/gpt-5.6-luna",
      "opencode-go/longcat-2.0",
      "opencode-go/qwen3.8-flash",
      "opencode-go/mimo-v2.5-pro",
      "opencode-go/gpt-5.6-luna#low",
      "opencode-go/minimax-m3",
      "opencode/glm-5.3-flash",
      "opencode/gpt-5.6-luna",
      "opencode/qwen3.6-plus",
      "opencode/glm-5.1"
    ],
    "zai-coding-plan/glm-5.3": [
      "opencode-go/kimi-k2.7-code",
      "opencode-go/glm-5.2",
      "opencode-go/qwen3.8-max#xhigh",
      "opencode-go/glm-5.3",
      "opencode-go/glm-5.3#high",
      "opencode/glm-5.3",
      "opencode/glm-5.2",
      "opencode/glm-5.3#high"
    ],
    "opencode-go/kimi-k3.1-pro": [
      "opencode-go/grok-4.7#xhigh",
      "zai-coding-plan/glm-5.3#max",
      "opencode/deepseek-v4-pro"
    ],
    "opencode-go/grok-4.6": [
      "opencode-go/qwen3.8-max#xhigh",
      "zai-coding-plan/glm-5.3#high",
      "opencode/glm-5.3#high"
    ],
    "opencode-go/qwen3.8-max": [
      "opencode-go/grok-4.7#xhigh",
      "opencode-go/kimi-k3.1-pro#max",
      "zai-coding-plan/glm-5.3#high",
      "opencode/deepseek-v4-pro"
    ],
    "opencode-go/minimax-m3": [
      "opencode-go/grok-4.7",
      "zai-coding-plan/glm-5.3-flash#low",
      "opencode/gemini-3-flash"
    ],
    "opencode-go/gpt-5.6-luna": [
      "zai-coding-plan/glm-5.3-flash",
      "opencode/glm-5.3-flash"
    ]
  },
  "providers": {
    "opencode": {
      "models": {
        "jev-1.13-free": {
          "type": "decision",
          "name": "Jev 1.13 Free",
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "jev-1.13": {
          "type": "decision",
          "name": "Jev 1.13",
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "cost": {
            "input": 0.042,
            "output": 0
          }
        }
      }
    }
  },
  "mcp": {
    "home": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec bash \"$HOME/.config/opencode/scripts/mcp-home-wrapper.sh\""
      ],
      "enabled": true,
      "timeout": 30000
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "lsp": true
}
