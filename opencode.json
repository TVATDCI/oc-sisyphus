{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@4.7.5", "sisyphus-gates"],
  "default_agent": "sisyphus",
  "mcp": {
    "home": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/vladi/Documents/Main-vault",
        "/home/vladi/AGENTS",
        "/home/vladi/.sisyphus",
        "/home/vladi/.config/opencode"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": ["semble", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": "ask"
  },
  "lsp": true
}
