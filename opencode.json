{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@4.19.4",
    [
      "./plugins/sisyphus-gates",
      {
        "verdict_key_command": "cat ~/.local/share/sisyphus-gate-key",
        "sandbox_paths": ["/tmp/"],
        "sandbox_allowed_commands": [
          "npm install",
          "npm test",
          "npm run ",
          "bun add ",
          "bun install",
          "bunx ",
          "node ",
          "tsc --noEmit",
          "git diff",
          "git show",
          "git log"
        ]
      }
    ]
  ],
  "default_agent": "sisyphus",
  "mcp": {
    "home": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec bash \"$HOME/.config/opencode/scripts/mcp-home-wrapper.sh\""
      ],
      "enabled": true,
      "timeout": 30000
    },
    "semble": {
      "type": "local",
      "command": ["semble", "mcp"],
      "enabled": true
    }
  },
  "lsp": true
}
