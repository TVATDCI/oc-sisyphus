{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@4.12.1",
    [
      "./plugins/sisyphus-gates",
      {
        "verdict_key_command": "cat ~/.local/share/sisyphus-gate-key",
        "sandbox_paths": ["/tmp/"],
        "sandbox_allowed_commands": [
          "npm install",
          "npm test",
          "npm run ",
          "bun add ",
          "bun install",
          "bunx ",
          "node ",
          "tsc --noEmit",
          "git diff",
          "git show",
          "git log"
        ]
      }
    ]
  ],
  "default_agent": "sisyphus",
  "mcp": {
    "home": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/vladi/Main-vault",
        "/home/vladi/AGENTS",
        "/home/vladi/.sisyphus",
        "/home/vladi/.config/opencode",
        "/home/vladi/developer/Reference/meta"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": ["semble", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": "ask"
  },
  "lsp": true
}
