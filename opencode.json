{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@4.12.1",
    [
      "./plugins/sisyphus-gates",
      {
        "verdict_key_command": "cat ~/.local/share/sisyphus-gate-key"
      }
    ]
  ],
  "default_agent": "sisyphus",
  "mcp": {
    "home": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/vladi/Main-vault",
        "/home/vladi/AGENTS",
        "/home/vladi/.sisyphus",
        "/home/vladi/.config/opencode"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": ["semble", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": "ask"
  },
  "lsp": true
}
