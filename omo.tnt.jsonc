// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "auto_update": false,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "cooldown_seconds": 15,
      "timeout_seconds": 10,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true,
    },
    "agents": {
      "sisyphus": {
        "prompt_append": "file://~/.config/opencode/prompts/sisyphus-guidance.md",
        "ultrawork": {
          "model": "zai-coding-plan/glm-5.3",
          "reasoning": "high",
        },
        "model": "zai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
        ],
      },
      "hephaestus": {
        "prompt_append": "file://~/.config/opencode/prompts/hephaestus-guidance.md",
        "model": "zai-coding-plan/glm-5.2",
        "temperature": 0.1,
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "oracle": {
        "prompt_append": "file://~/.config/opencode/prompts/oracle-guidance.md",
        "model": "opencode-go/kimi-k3",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5.3",
          },
          {
            "model": "opencode-go/grok-4.6",
          },
        ],
      },
      "librarian": {
        "prompt_append": "file://~/.config/opencode/prompts/librarian-guidance.md",
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-4.7",
          },
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
        ],
      },
      "explore": {
        "prompt_append": "file://~/.config/opencode/prompts/explore-guidance.md",
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-4.7",
          },
          {
            "model": "opencode-go/glm-5.3-flash",
          },
        ],
      },
      "multimodal-looker": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/mimo-v2.5-pro",
          },
          {
            "model": "opencode/mimo-v2.5-free",
          },
        ],
      },
      "prometheus": {
        "prompt_append": "file://~/.config/opencode/prompts/prometheus-guidance.md",
        "model": "zai-coding-plan/glm-5.2",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode-go/glm-5.2",
          },
        ],
      },
      "metis": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "momus": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-4.7",
          },
          {
            "model": "opencode/deepseek-v4-flash",
          },
        ],
      },
      "sisyphus-junior": {
        "model": "zai-coding-plan/glm-5-turbo",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5.3-flash",
          },
          {
            "model": "opencode-go/kimi-k2.6",
          },
          {
            "model": "opencode/kimi-k2.6",
          },
        ],
        "temperature": 0.2,
      },
      "archivist": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
        ],
      },
      "athena": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-4.7",
          },
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
        ],
      },
      "auditor": {
        "model": "zai-coding-plan/glm-5.2",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "explorer": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "temperature": 1.0,
        "top_p": 0.95,
        "reasoning": "max",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
        ],
      },
      "post-reviewer": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "reviewer": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "fullstack-dev-tester": {
        "model": "zai-coding-plan/glm-5.2",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
    },
    "categories": {
      "visual-engineering": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode/qwen3.6-plus",
          },
          {
            "model": "opencode/glm-5.1",
          },
        ],
      },
      "ultrabrain": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/grok-4.6",
          },
          {
            "model": "opencode/deepseek-v4-pro",
          },
        ],
      },
      "deep": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "artistry": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "temperature": 0.7,
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.1",
          },
          {
            "model": "opencode/gemini-3-flash",
          },
        ],
      },
      "quick": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/glm-5.3-flash",
          },
        ],
      },
      "unspecified-low": {
        "model": "opencode-go/gpt-5.6-luna",
        "temperature": 0.2,
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5.3-flash",
          },
          {
            "model": "opencode/glm-5.1",
          },
        ],
      },
      "unspecified-high": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
        ],
      },
      "writing": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
          {
            "model": "opencode/ling-3.0-flash-fin-free",
          },
        ],
      },
      "git-commit-message": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/gpt-5.6-luna",
          },
          {
            "model": "opencode/ling-3.0-flash-fin-free",
          },
        ],
        "description": "All git operations — commits, branches, rebases, history searches",
        "prompt_append": "file://~/.config/opencode/prompts/git-commit-message-guidance.md",
      },
    },
    "background_task": {
      "defaultConcurrency": 10,
      "staleTimeoutMs": 180000,
      "providerConcurrency": {
        "opencode-go": 10,
        "opencode": 10,
        "zai-coding-plan": 10,
      },
      "modelConcurrency": {
        "zai-coding-plan/glm-5.3": 3,
        "zai-coding-plan/glm-5.3-flash": 5,
        "zai-coding-plan/glm-5.2": 3,
        "zai-coding-plan/glm-5-turbo": 5,
        "zai-coding-plan/glm-4.7": 5,
        "opencode-go/glm-5.3": 3,
        "opencode-go/glm-5.2": 3,
        "opencode-go/glm-5.1": 3,
        "opencode-go/kimi-k3": 2,
        "opencode-go/gpt-5.6-luna": 5,
        "opencode-go/glm-5.3-flash": 5,
        "opencode-go/mimo-v2.5-pro": 1,
        "opencode-go/kimi-k2.6": 2,
        "opencode/glm-5.2": 2,
        "opencode/glm-5.1": 3,
        "opencode/qwen3.6-plus": 1,
        "opencode/mimo-v2.5-free": 2,
        "opencode/grok-4.6": 2,
        "opencode/deepseek-v4-pro": 2,
        "opencode/deepseek-v4-flash": 5,
        "opencode/gemini-3-flash": 1,
        "opencode/ling-3.0-flash-fin-free": 3,
      },
    },
    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,
      "preemptive_compaction": true,
    },
    "git_master": {
      "include_co_authored_by": false,
    },
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
  ],
}
