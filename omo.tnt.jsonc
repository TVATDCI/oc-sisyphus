        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5.3",
            "reasoning": "high",
          },
          {
            "model": "opencode-go/qwen3.8-max",
            "reasoning": "high",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3",
        "reasoning": "medium",
        "temperature": 0.1,
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5-turbo",
            "reasoning": "low",
          },
          {
            "model": "opencode-go/kimi-k2.7-code",
            "reasoning": "medium",
          },
          {
            "model": "opencode-go/glm-5.3",
          },
          {
            "model": "opencode/glm-5.2",
          },
