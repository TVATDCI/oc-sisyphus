// OMO configuration
//
// ⚠️ KNOWN TRAP (BUILD #14, 2026-09-14) — do NOT follow `omo doctor`'s
// "Replace fallback_models with models / run config migrate" nudge yet.
// On oh-my-openagent 4.19.4, canonical `models[]` chains are stripped by
// zod at load and invisible to the legacy-only runtime readers (upstream
// #6868; fix PR #7209 still open). Converting now = silent default-model
// routing. Re-evaluate only when: 5.0 stable + #7209 merged + #6567 resolved.
// See: herdr-collab/build14-omo-align/ (timing memo + findings).
//
// ⚠️ DEPLOY HAZARD (TNT, 2026-09-14): the LIVE ~/.omo/omo.jsonc drifted
// AHEAD of this variant (184+/45−, +139 net — richer chains/concurrency).
// This variant was refreshed FROM live 2026-09-14 (F1 reconciliation).
// scripts/deploy-omo.sh now refuses when live≠variant — use --capture only
// for intentional snapshots. Never follow the config-migrate nudge (above).
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "auto_update": false,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [401, 403, 404, 429, 500, 502, 503, 504],
      "cooldown_seconds": 15,
      "timeout_seconds": 45,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true,
    },
    "agents": {
      "sisyphus": {
        "prompt_append": "file://~/.config/opencode/prompts/sisyphus-guidance.md",
        "model": "zai-coding-plan/glm-5.3",
        "reasoning": "max",
        "temperature": 0.1,
        "ultrawork": {
          "model": "zai-coding-plan/glm-5.3",
          "reasoning": "high",
        },
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3",
            "reasoning": "max",
          },
          {
            "model": "opencode-go/grok-4.6",
            "reasoning": "high",
          },
          {
            "model": "opencode-go/kimi-k2.7-code",
            "reasoning": "high",
          },
          {
            "model": "opencode/glm-5.3",
          },
        ],
      },
      "hephaestus": {
        "prompt_append": "file://~/.config/opencode/prompts/hephaestus-guidance.md",
        "model": "zai-coding-plan/glm-5-turbo",
        "reasoning": "medium",
        "temperature": 0.1,
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5-2",
            "reasoning": "low",
          },
          {
            "model": "opencode-go/kimi-k2.7-code",
            "reasoning": "medium",
          },
          {
            "model": "opencode-go/glm-5.2",
          },
          {
            "model": "opencode/glm-5.2",
          },
        ],
      },
      "oracle": {
        "prompt_append": "file://~/.config/opencode/prompts/oracle-guidance.md",
        "model": "opencode-go/kimi-k3",
        "reasoning": "max",
        "temperature": 0.0,
        "fallback_models": [
          {
            "model": "opencode-go/grok-4.6",
            "reasoning": "max",
          },
          {
            "model": "zai-coding-plan/glm-5.3",
            "reasoning": "max",
          },
          {
            "model": "opencode/deepseek-v4-pro",
          },
        ],
      },
      "librarian": {
        "prompt_append": "file://~/.config/opencode/prompts/librarian-guidance.md",
        "model": "zai-coding-plan/glm-5.3-flash",
        "temperature": 1.0,
        "top_p": 0.95,
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode-go/longcat-2.0",
          },
          {
            "model": "opencode/glm-5.3-flash",
          },
        ],
      },
      "explore": {
        "prompt_append": "file://~/.config/opencode/prompts/explore-guidance.md",
        "model": "zai-coding-plan/glm-5.3-flash",
        "temperature": 1.0,
        "top_p": 0.95,
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "opencode-go/qwen3.8-flash",
          },
          {
            "model": "opencode-go/gpt-5.6-luna",
          },
          {
            "model": "opencode/glm-5.3-flash",
          },
        ],
      },
      "multimodal-looker": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "temperature": 1.0,
        "top_p": 0.95,
        "fallback_models": [
