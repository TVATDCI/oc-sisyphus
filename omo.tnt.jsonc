      "unspecified-low": {
        "model": "opencode-go/gpt-5.6-luna",
        "reasoning": "low",
        "temperature": 0.2,
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5.3-flash",
          },
          {
            "model": "opencode/glm-5.3-flash",
          },
        ],
      },
      "unspecified-high": {
        "model": "zai-coding-plan/glm-5.3",
        "reasoning": "high",
        "temperature": 0.1,
        "fallback_models": [
          {
            "model": "zai-coding-plan/glm-5-turbo",
            "reasoning": "low",
          },
          {
            "model": "opencode-go/gpt-5.6-luna",
