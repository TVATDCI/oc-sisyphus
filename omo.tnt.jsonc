    "background_task": {
      "defaultConcurrency": 10,
      "staleTimeoutMs": 180000,
      "providerConcurrency": {
        "opencode-go": 10,
        "opencode": 10,
        "zai-coding-plan": 10,
      },
      "modelConcurrency": {
        "zai-coding-plan/glm-5.3": 3,
        "zai-coding-plan/glm-5.3-flash": 5,
        "zai-coding-plan/glm-5.2": 3,
        "zai-coding-plan/glm-5-turbo": 5,
