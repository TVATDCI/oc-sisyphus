        "opencode-go/kimi-k2.6": 2,
        "opencode/glm-5.2": 2,
        "opencode/glm-5.1": 3,
        "opencode/gpt-5.6-luna": 5,
        "opencode/qwen3.6-plus": 1,
        "opencode/mimo-v2.5-free": 2,
        "opencode/grok-4.6": 2,
        "opencode/deepseek-v4-pro": 2,
        "opencode/deepseek-v4-flash": 5,
        "opencode/gemini-3-flash": 1,
        "opencode/ling-3.0-flash-fin-free": 3,
      },
    },
    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,
      "preemptive_compaction": true,
    },
    "git_master": {
      "include_co_authored_by": false,
    },
